{
  "name": "product/ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/product/ui/src",
  "projectType": "library",
  "tags": ["domain:product", "type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/product/ui",
        "main": "packages/product/ui/src/index.ts",
        "tsConfig": "packages/product/ui/tsconfig.lib.json",
        "assets": ["packages/product/ui/*.md"],
        "skipTypeCheck": true,
        "stripLeadingPaths": true
      }
    }
  }
}
