{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/packages/share/domain",
    "tsBuildInfoFile": "../../../dist/out-tsc/packages/share/domain/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "types": ["node"],
    "rootDir": "src",
    "composite": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
