{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/packages/user/controller",
    "tsBuildInfoFile": "../../../dist/out-tsc/packages/user/controller/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "types": ["node"],
    "rootDir": "src",
    "composite": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../share/domain/tsconfig.lib.json"
    },
    {
      "path": "../data/tsconfig.lib.json"
    },
    {
      "path": "../../share/function/tsconfig.lib.json"
    },
    {
      "path": "../../share/const/tsconfig.lib.json"
    }
  ]
}
