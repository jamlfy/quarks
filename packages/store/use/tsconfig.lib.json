{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/packages/store/use",
    "tsBuildInfoFile": "../../../dist/out-tsc/packages/store/use/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "composite": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
