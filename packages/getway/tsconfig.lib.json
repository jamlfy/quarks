{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/packages/getway",
    "tsBuildInfoFile": "../../dist/out-tsc/packages/getway/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "types": ["node"],
    "rootDir": "src",
    "composite": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../user/data/tsconfig.lib.json"
    },
    {
      "path": "../transaction/data/tsconfig.lib.json"
    },
    {
      "path": "../share/const/tsconfig.lib.json"
    }
  ]
}
