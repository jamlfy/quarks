  <header>
    <nav>
      <a href="/">Quarks</a>
      <div>
        <a href="/me">Mi perfil</a>
        <a href="/purchases">Mis compras</a>
        <a href="/create-testing">Crear testing</a>
        <a href="/panel">Mis campañas</a>
      </div>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>&copy; 2026 Quarks</p>
  </footer>
</PublicLayout>
