{
  "compilerOptions": {
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@quarks/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@quarks/user-data": ["./packages/user/data/src/index.ts"],
      "@quarks/user-controller": ["./packages/user/controller/src/index.ts"],
      "@quarks/user-use": ["./packages/user/use/src/index.ts"],
      "@quarks/share-use": ["./packages/share/use/src/index.ts"],
      "@quarks/store-controller": ["./packages/store/controllers/src/index.ts"],
      "@quarks/store-data": ["./packages/store/data/src/index.ts"],
      "@quarks/store-use": ["./packages/store/use/src/index.ts"],
      "@quarks/product-data": ["./packages/product/data/src/index.ts"],
      "@quarks/product-controller": [
        "./packages/product/controller/src/index.ts"
      ],
      "@quarks/testing-data": ["./packages/testing/data/src/index.ts"],
      "@quarks/testing-controller": [
        "./packages/testing/controller/src/index.ts"
      ],
      "@quarks/transaction-data": ["./packages/transaction/data/src/index.ts"],
      "@quarks/transaction-controller": [
        "./packages/transaction/controller/src/index.ts"
      ],
      "@quarks/share-function": ["./packages/share/function/src/index.ts"],
      "@quarks/share-const": ["./packages/share/const/src/index.ts"],
      "@quarks/share-domain": ["./packages/share/domain/src/index.ts"],
      "@quarks/share-middleware": ["./packages/share/middleware/src/index.ts"],
      "@quarks/getway": ["./packages/getway/src/index.ts"],
      "@quarks/event": ["./packages/event/src/index.ts"],
      "@quarks/user-ui": ["./packages/user/ui/src/index.ts"],
      "@quarks/testing-ui": ["./packages/testing/ui/src/index.ts"],
      "@quarks/store-ui": ["./packages/store/ui/src/index.ts"],
      "@quarks/product-ui": ["./packages/product/ui/src/index.ts"]
    }
  }
}
